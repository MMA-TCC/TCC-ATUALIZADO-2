<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MMA - Meu Serviço Minha Arte</title>

    <link rel="stylesheet" href="style.css">

    <!-- Ícones -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="header">

        <div class="logo">
            <div class="logo-icon">
                <i class="fa-solid fa-house"></i>
            </div>

            <div class="logo-text">
                <strong>MMA</strong>
                <span>MEU SERVIÇO MINHA ARTE</span>
            </div>
        </div>


        <nav class="menu">

            <a href="#" class="active">Início</a>
            <a href="#">Serviços</a>
            <a href="#">Profissionais</a>
            <a href="#">Orçamentos</a>
            <a href="#">Projetos</a>
            <a href="#">Sobre nós</a>

        </nav>


        <div class="header-buttons">

            <button class="btn-login">
                <i class="fa-regular fa-user"></i>
                Entrar
            </button>

            <button class="btn-register">
                Cadastre-se
            </button>

        </div>

    </header>


    <!-- ================= HERO ================= -->

    <section class="hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <!-- LADO ESQUERDO -->

            <div class="hero-text">

                <h1>
                    Conectamos você<br>
                    aos <span>melhores serviços</span><br>
                    da construção civil
                </h1>

                <p>
                    Encontre profissionais qualificados, solicite orçamentos
                    e acompanhe seus projetos do início ao fim.
                </p>

                <div class="hero-buttons">

                    <button class="btn-primary">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        Quero contratar um serviço
                    </button>

                    <button class="btn-secondary">
                        <i class="fa-regular fa-user"></i>
                        Sou profissional
                    </button>

                </div>

            </div>


            <!-- CAIXA DE BUSCA -->

            <div class="search-box">

                <h2>Encontre o serviço ideal</h2>

                <div class="search-input">

                    <input
                        type="text"
                        placeholder="Ex.: Reforma, Elétrica, Pintura..."
                    >

                    <button>
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                </div>


                <div class="categories">

                    <div class="category">
                        <i class="fa-solid fa-hammer"></i>
                        <span>Obras e<br>Reformas</span>
                    </div>

                    <div class="category">
                        <i class="fa-solid fa-bolt"></i>
                        <span>Elétrica</span>
                    </div>

                    <div class="category">
                        <i class="fa-solid fa-faucet"></i>
                        <span>Hidráulica</span>
                    </div>

                    <div class="category">
                        <i class="fa-solid fa-paint-roller"></i>
                        <span>Pintura</span>
                    </div>

                    <div class="category">
                        <i class="fa-solid fa-grip"></i>
                        <span>Outros<br>Serviços</span>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= ESTATÍSTICAS ================= -->

    <section class="statistics">

        <div class="stat">

            <div class="stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>
                <strong>+1.200</strong>
                <p>Profissionais<br>cadastrados</p>
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                <i class="fa-regular fa-file-lines"></i>
            </div>

            <div>
                <strong>+3.500</strong>
                <p>Orçamentos<br>realizados</p>
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                <i class="fa-regular fa-circle-check"></i>
            </div>

            <div>
                <strong>+2.800</strong>
                <p>Serviços<br>concluídos</p>
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                <i class="fa-regular fa-star"></i>
            </div>

            <div>
                <strong>4,8/5</strong>
                <p>Avaliação dos<br>clientes</p>
            </div>

        </div>

    </section>


    <!-- ================= COMO FUNCIONA ================= -->

    <section class="how-it-works">

        <h2>Como funciona?</h2>

        <div class="steps">

            <div class="step">

                <div class="step-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <div class="step-content">

                    <h3>1. Encontre</h3>

                    <p>
                        Busque por serviços ou profissionais
                        de confiança perto de você.
                    </p>

                </div>

            </div>


            <div class="step">

                <div class="step-icon">
                    <i class="fa-regular fa-file-lines"></i>
                </div>

                <div class="step-content">

                    <h3>2. Solicite um orçamento</h3>

                    <p>
                        Receba propostas e compare
                        preços, prazos e avaliações.
                    </p>

                </div>

            </div>


            <div class="step">

                <div class="step-icon">
                    <i class="fa-regular fa-handshake"></i>
                </div>

                <div class="step-content">

                    <h3>3. Contrate com segurança</h3>

                    <p>
                        Escolha o melhor profissional
                        e acompanhe tudo pela plataforma.
                    </p>

                </div>

            </div>


            <div class="step">

                <div class="step-icon">
                    <i class="fa-regular fa-circle-check"></i>
                </div>

                <div class="step-content">

                    <h3>4. Acompanhe o projeto</h3>

                    <p>
                        Monitore o andamento do serviço
                        até a conclusão.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= BANNER FINAL ================= -->

    <section class="bottom-banner">

        <div class="banner-icon">
            <i class="fa-solid fa-house"></i>
        </div>

        <h2>
            Transforme seu projeto em realidade com a MMA!
        </h2>

        <button>
            Comece agora
            <i class="fa-solid fa-chevron-right"></i>
        </button>

    </section>


</body>

</html>
